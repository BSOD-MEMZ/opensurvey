OPENSURVEY_MONGO_DB_NAME=opensurvey
OPENSURVEY_MONGO_URL=mongodb://127.0.0.1:27017

OPENSURVEY_MONGO_AUTH_SOURCE=

OPENSURVEY_RESPONSE_AES_ENCRYPT_SECRET_KEY=dataAesEncryptSecretKey
OPENSURVEY_HTTP_DATA_ENCRYPT_TYPE=rsa

OPENSURVEY_JWT_SECRET=opensurveyJwtSecret
OPENSURVEY_JWT_EXPIRES_IN=8h

OPENSURVEY_LOGGER_FILENAME=./logs/app.log

OPENSURVEY_REPORT=true
